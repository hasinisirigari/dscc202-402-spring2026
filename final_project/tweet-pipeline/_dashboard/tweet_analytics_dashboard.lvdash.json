{
  "datasets": [
    {
      "name": "da3d8df0",
      "displayName": "total_tweets",
      "queryLines": [
        "SELECT COUNT(*) AS total_tweets FROM workspace.default.tweets_bronze;"
      ]
    },
    {
      "name": "794eca0d",
      "displayName": "mention_counts",
      "queryLines": [
        "SELECT\n",
        "  COUNT(*) FILTER (WHERE mention IS NOT NULL) AS with_mentions,\n",
        "  COUNT(*) FILTER (WHERE mention IS NULL) AS without_mentions\n",
        "FROM workspace.default.tweets_silver;"
      ]
    },
    {
      "name": "b35649a4",
      "displayName": "top_users",
      "queryLines": [
        "SELECT user, COUNT(*) AS tweet_count\n",
        "FROM workspace.default.tweets_bronze\n",
        "GROUP BY user\n",
        "ORDER BY tweet_count DESC\n",
        "LIMIT 10;"
      ]
    },
    {
      "name": "bd3e4174",
      "displayName": "mention_sentiment",
      "queryLines": [
        "SELECT mention, (positive - negative) AS positive_power\n",
        "FROM workspace.default.gold_tweet_aggregations\n",
        "ORDER BY positive_power DESC\n",
        "LIMIT 10;"
      ]
    },
    {
      "name": "6911f372",
      "displayName": "top_negative_mentions",
      "queryLines": [
        "SELECT mention, (negative - positive) AS negative_power\n",
        "FROM workspace.default.gold_tweet_aggregations\n",
        "ORDER BY negative_power DESC\n",
        "LIMIT 10;"
      ]
    }
  ],
